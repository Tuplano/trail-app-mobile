# Copy to .env.local (git-ignored) to override locally. src/config/env.ts reads these.
#
# For EAS builds, set them per environment instead:
#   development → EXPO_PUBLIC_APP_ENV=development
#   preview     → EXPO_PUBLIC_APP_ENV=staging,    EXPO_PUBLIC_API_URL=<staging API origin>
#   production  → EXPO_PUBLIC_APP_ENV=production, EXPO_PUBLIC_API_URL=<production API origin>
# e.g. npx eas-cli@latest env:create --environment preview --name EXPO_PUBLIC_API_URL --value https://... --visibility plaintext

# development | staging | production (defaults to development)
EXPO_PUBLIC_APP_ENV=development

# API origin without /api/v1. Leave unset in development to use Metro's host on port 3000,
# which lets a phone on the same Wi-Fi reach the API running on your computer.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
